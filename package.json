{
  "name": "shiri-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/cf.mjs dev --port 8787",
    "test": "node --test tests/*.test.mjs",
    "db:local": "node scripts/cf.mjs d1 migrations apply DB --local",
    "db:remote": "node scripts/cf.mjs d1 migrations apply DB --remote",
    "deploy": "node scripts/cf.mjs deploy",
    "preview": "node scripts/preview.mjs",
    "check": "node --check public/app.js && node --check worker/index.js"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
